  - GeneralId: carl
    Name: "\u5361\u5C14\xB7\u53E4\u65AF\u5854\u592B\xB7\u5F17\u5170\u683C\u5C14"
    Biography: "\u5361\u5C14\xB7\u53E4\u65AF\u5854\u592B\xB7\u5F17\u5170\u683C\u5C14\u4F5C\u4E3A\u5C06\u95E8\u864E\u5B50\uFF0C\u5F17\u5170\u683C\u5C14\u4E0D\u4EC5\u7CBE\u901A\u9646\u6218\uFF0C\u8FD8\u662F\u5353\u8D8A\u7684\u6D77\u519B\u7EDF\u5E05\u3002\u4ED6\u5728\u4E09\u5341\u5E74\u6218\u4E89\u540E\u671F\u63A5\u66FF\u6258\u5C14\u65AF\u6ED5\u677E\uFF0C\u5C55\u73B0\u4E86\u6781\u5F3A\u7684\u8FDB\u653B\u6027\u3002\u4ED6\u4E0E\u6CD5\u519B\u7EDF\u5E05\u8482\u96F7\u7EB3\u5B50\u7235\u8054\u624B\uFF0C\u5F7B\u5E95\u7C89\u788E\u4E86\u5E1D\u56FD\u6700\u540E\u7684\u62B5\u6297\u3002\u4ED6\u4EE3\u8868\u4E86\u745E\u5178\u5E1D\u56FD\u5D1B\u8D77\u65F6\u671F\u7684\u519B\u4EBA\u5F62\u8C61\uFF1A\u591A\u624D\u591A\u827A\u3001\u5BF9\u6743\u529B\u5145\u6EE1\u6E34\u671B\u4E14\u6781\u5177\u4FB5\u7565\u6027\u3002"
