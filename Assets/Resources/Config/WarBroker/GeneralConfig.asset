  - GeneralId: bernhard
    Name: "\u8D1D\u6069\u54C8\u5FB7"
    Biography: "\u867D\u7136\u8D1D\u6069\u54C8\u5FB7\u662F\u8428\u514B\u68EE-\u9B4F\u739B\u7684\u738B\u5B50\uFF0C\u5E76\u975E\u745E\u5178\u4EBA\uFF0C\u4F46\u5728\u5415\u5C91\u4F1A\u6218\u4E2D\uFF0C\u4ED6\u5728\u53E4\u65AF\u5854\u592B\u727A\u7272\u7684\u5173\u952E\u65F6\u523B\u633A\u8EAB\u800C\u51FA\u63A5\u8FC7\u6307\u6325\u6743\uFF0C\u6FC0\u52B1\u5168\u519B\u53D1\u52A8\u4E86\u590D\u4EC7\u5F0F\u7684\u53CD\u653B\u5E76\u6700\u7EC8\u53D6\u80DC\u3002\u4ED6\u662F\u4E00\u540D\u5178\u578B\u7684\u96C7\u4F63\u519B\u7EDF\u5E05\uFF0C\u62E5\u6709\u6781\u9AD8\u7684\u5A01\u671B\u548C\u91CE\u5FC3\uFF0C\u5728\u6218\u4E89\u540E\u671F\u6210\u4E3A\u5DE6\u53F3\u6B27\u9646\u5C40\u52BF\u7684\u5173\u952E\u4EBA\u7269\u3002"
