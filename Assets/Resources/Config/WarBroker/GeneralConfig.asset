  - GeneralId: johann
    Name: "\u7EA6\u7FF0\xB7\u51AF\xB7\u963F\u5C14\u5FB7\u6797\u6839"
    Biography: "\u963F\u5C14\u5FB7\u6797\u6839\u51FA\u8EAB\u5BD2\u5FAE\uFF0C\u51ED\u501F\u7EAF\u7CB9\u7684\u519B\u4E8B\u624D\u5E72\u4E00\u8DEF\u664B\u5347\u3002\u4ED6\u4E0D\u4EC5\u662F\u4E00\u540D\u51FA\u8272\u7684\u6218\u672F\u5BB6\uFF0C\u66F4\u5177\u5907\u6781\u9AD8\u7684\u884C\u653F\u548C\u540E\u52E4\u5929\u8D4B\u3002\u5728\u8482\u5229\u53BB\u4E16\u540E\uFF0C\u4ED6\u66FE\u77ED\u6682\u63A5\u8FC7\u6307\u6325\u6743\uFF0C\u5E76\u4E0E\u534E\u4F26\u65AF\u5766\u5408\u4F5C\u3002\u4ED6\u4EE5\u5934\u8111\u51B7\u9759\u3001\u5584\u4E8E\u5229\u7528\u5730\u5F62\u9632\u5FA1\u8457\u79F0\uFF0C\u662F\u5929\u4E3B\u6559\u8054\u76DF\u519B\u4E2D\u5C11\u6709\u7684\u201C\u5112\u5C06\u201D\u7C7B\u578B\uFF0C\u6700\u7EC8\u5728\u4FDD\u536B\u96F7\u6839\u65AF\u5821\u7684\u6218\u6597\u4E2D\u6B89\u804C\u3002"
