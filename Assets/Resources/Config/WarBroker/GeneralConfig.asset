  - GeneralId: gottfried
    Name: "\u6208\u7279\u5F17\u91CC\u5FB7\xB7\u6D77\u56E0\u91CC\u5E0C\xB7\u51AF\xB7\u5E15\u5F6D\u6D77\u59C6"
    Biography: "\u6208\u7279\u5F17\u91CC\u5FB7\xB7\u6D77\u56E0\u91CC\u5E0C\xB7\u51AF\xB7\u5E15\u5F6D\u6D77\u59C6\u662F\u4E09\u5341\u5E74\u6218\u4E89\u4E2D\u6700\u8457\u540D\u7684\u9A91\u5175\u7EDF\u5E05\u4E4B\u4E00\uFF0C\u4EE5\u5176\u65E0\u4E0E\u4F26\u6BD4\u7684\u52C7\u6C14\u548C\u6EE1\u8EAB\u7684\u6218\u4F24\u95FB\u540D\u3002\u4F5C\u4E3A\u8482\u5229\u6700\u9510\u5229\u7684\u201C\u77DB\u5934\u201D\uFF0C\u4ED6\u6307\u6325\u7740\u5A01\u9707\u6B27\u9646\u7684\u9ED1\u7532\u9A91\u5175\uFF08Cuirassiers\uFF09\u3002\u5728\u9A6C\u683C\u5FB7\u5821\u4E4B\u56F4\u548C\u5E03\u8D56\u6ED5\u8D39\u5C14\u5FB7\u6218\u5F79\u4E2D\uFF0C\u4ED6\u59CB\u7EC8\u51B2\u950B\u5728\u524D\u3002\u867D\u7136\u4ED6\u6709\u65F6\u8FC7\u4E8E\u51B2\u52A8\u5BFC\u81F4\u6218\u672F\u5931\u63A7\uFF0C\u4F46\u5176\u5BF9\u5929\u4E3B\u6559\u4F1A\u7684\u5FE0\u8BDA\u548C\u6218\u6597\u610F\u5FD7\u8BA9\u4ED6\u6210\u4E3A\u4E86\u5E1D\u56FD\u7684\u4F20\u5947\u3002"
