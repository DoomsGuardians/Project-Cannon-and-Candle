  - GeneralId: arnim
    Name: "\u6C49\u65AF\xB7\u683C\u5965\u5C14\u683C\xB7\u51AF\xB7\u963F\u5C14\u5C3C\u59C6"
    Biography: "\u6C49\u65AF\xB7\u4E54\u6CBB\xB7\u51AF\xB7\u963F\u5C14\u5C3C\u59C6\u662F\u4E00\u4F4D\u5143\u5E05\u548C\u5916\u4EA4\u5B98
      \u3002\u4ED6\u5728\u745E\u5178 \u3001 \u6CE2\u5170\u3001\u5E1D\u56FD\u548C\u8428\u514B\u68EE\u9009\u5E1D\u4FAF\u4E4B\u95F4\u8F6E\u6362\u670D\u52A1\uFF0C\u66FE\u4E3A\u534E\u4F26\u65AF\u5766\u7684\u91CD\u8981\u526F\u624B\uFF0C\u6307\u6325\u4E86\u5BF9\u6CE2\u7F57\u7684\u6D77\u6E2F\u53E3\u65BD\u7279\u62C9\u5C14\u677E\u5FB7\u7684\u56F4\u653B\u3002\u540E\u56E0\u4FE1\u4EF0\u539F\u56E0\u6297\u8BAE\u7687\u5E1D\u7684\u5B97\u6559\u653F\u7B56\u800C\u8F9E\u804C\uFF0C\u8F6C\u800C\u6548\u529B\u4E8E\u8428\u514B\u68EE\u9009\u5E1D\u4FAF\u3002"
    Portrait: {fileID: 21300000, guid: 42be6c75d870c1e41b3e5fd1a0361291, type: 3}
    Personality: 1
    InitialTroops: 20
    InitialTrust: 50
    InitialMorale: 60
    AtkBidModifier: 0.5
    DefBidModifier: 1.5
    RetBidModifier: 1.2
