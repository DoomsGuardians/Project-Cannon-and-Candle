  AllyGenerals:
  - GeneralId: adam
    Name: " \u4E9A\u5F53\xB7\u57C3\u5C14\u5FB7\u66FC\xB7\u7279\u8328\u5361"
    Biography: "\u4E9A\u5F53\xB7\u57C3\u5C14\u5FB7\u66FC\xB7\u7279\u5C14\u5947\u5361\u662F\u4E09\u5341\u5E74\u6218\u4E89\u671F\u95F4\u963F\u5C14\u5E03\u96F7\u5E0C\u7279\xB7\u51AF\xB7\u534E\u4F26\u65AF\u5766\u516C\u7235\u6700\u6838\u5FC3\u7684\u519B\u4E8B\u526F\u624B\u4E0E\u653F\u6CBB\u76DF\u53CB\u4E4B\u4E00\u3002\u4ED6\u7684\u4E00\u751F\u4E0E\u534E\u4F26\u65AF\u5766\u7684\u547D\u8FD0\u7D27\u5BC6\u76F8\u8FDE\uFF0C\u76F4\u81F3\u5171\u540C\u7684\u60B2\u5267\u6027\u7EC8\u70B9\u3002\n\u4ED6\u5B98\u81F3\u9646\u519B\u4E2D\u5C06\uFF0C\u76F4\u63A5\u6307\u63257-8\u4E2A\u6B65\u5175\u548C\u9A91\u5175\u519B\u56E2\uFF0C\u662F\u534E\u4F26\u65AF\u5766\u519B\u961F\u4E2D\u638C\u63E1\u5B9E\u6743\u7684\u91CD\u8981\u6307\u6325\u5B98\u3002"
    Portrait: {fileID: 21300000, guid: d69553cc79ba5514f91923fd25d0bd20, type: 3}
    Personality: 0
    InitialTroops: 20
    InitialTrust: 100
    InitialMorale: 70
    AtkBidModifier: 1
    DefBidModifier: 1
    RetBidModifier: 1
