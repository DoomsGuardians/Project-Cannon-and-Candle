  - GeneralId: johan
    Name: "\u7EA6\u7FF0\xB7\u5DF4\u5185\u5C14"
    Biography: "\u5DF4\u5185\u5C14\u662F\u53E4\u65AF\u5854\u592B\u6700\u5BA0\u7231\u7684\u5C06\u9886\u4E4B\u4E00\uFF0C\u88AB\u516C\u8BA4\u4E3A\u745E\u5178\u519B\u961F\u4E2D\u6700\u5177\u5929\u624D\u7684\u6218\u672F\u5BB6\u3002\u4ED6\u5728\u5E03\u8D56\u6ED5\u8D39\u5C14\u5FB7\u6218\u5F79\u4E2D\u6307\u6325\u53F3\u7FFC\u9A91\u5175\u7ACB\u4E0B\u8D6B\u8D6B\u6218\u529F\u3002\u53E4\u65AF\u5854\u592B\u727A\u7272\u540E\uFF0C\u4ED6\u63A5\u638C\u4E86\u745E\u5178\u5728\u5FB7\u610F\u5FD7\u7684\u5E05\u5370\u3002\u4ED6\u4EE5\u884C\u519B\u795E\u901F\u548C\u6027\u683C\u66B4\u8E81\u8457\u79F0\uFF0C\u5728\u9762\u4E34\u7EDD\u5883\u65F6\u603B\u80FD\u901A\u8FC7\u5927\u80C6\u7684\u673A\u52A8\u53CD\u8D25\u4E3A\u80DC\uFF0C\u88AB\u654C\u519B\u79F0\u4E3A\u201C\u745E\u5178\u4E4B\u864E\u201D\u3002"
