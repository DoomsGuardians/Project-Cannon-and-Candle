  - GeneralId: gustav
    Name: "\u53E4\u65AF\u5854\u592B\xB7\u970D\u6069"
    Biography: "\u970D\u6069\u4EE5\u51B7\u9759\u548C\u4E25\u8C28\u8457\u79F0\uFF0C\u662F\u53E4\u65AF\u5854\u592B\u624B\u4E0B\u6700\u7A33\u5065\u7684\u9632\u5FA1\u4E13\u5BB6\u3002\u4ED6\u5728\u5E03\u8D56\u6ED5\u8D39\u5C14\u5FB7\u6218\u5F79\u4E2D\u6307\u6325\u5DE6\u7FFC\uFF0C\u5728\u8428\u514B\u68EE\u76DF\u519B\u5D29\u6E83\u7684\u6781\u7AEF\u4E0D\u5229\u5C40\u9762\u4E0B\uFF0C\u7387\u9886\u745E\u5178\u6B65\u5175\u6210\u529F\u62B5\u6321\u4E86\u63D0\u5229\u4F2F\u7235\u7684\u4FA7\u7FFC\u8FDB\u653B\u3002\u5C3D\u7BA1\u540E\u6765\u5728\u8BB7\u5FB7\u6797\u6839\u6218\u5F79\u4E2D\u88AB\u4FD8\uFF0C\u4F46\u4ED6\u4F5C\u4E3A\u519B\u4E8B\u7EC4\u7EC7\u8005\u7684\u540D\u671B\u59CB\u7EC8\u4E0D\u5760\u3002"
