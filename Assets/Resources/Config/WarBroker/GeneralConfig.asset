  - GeneralId: lennart
    Name: "\u4F26\u7EB3\u7279\xB7\u6258\u5C14\u65AF\u6ED5\u677E"
    Biography: "\u4F26\u7EB3\u7279\xB7\u6258\u5C14\u65AF\u6ED5\u677E\u662F\u73B0\u4EE3\u70AE\u5175\u4E4B\u7236\u3002\u5728\u53E4\u65AF\u5854\u592B\u7684\u6307\u5BFC\u4E0B\uFF0C\u4ED6\u5C06\u7B28\u91CD\u7684\u706B\u70AE\u6539\u9020\u4E3A\u8F7B\u4FBF\u3001\u673A\u52A8\u7684\u56E2\u5C5E\u706B\u70AE\uFF0C\u5B9E\u73B0\u4E86\u6B65\u70AE\u534F\u540C\u3002\u6258\u5C14\u65AF\u6ED5\u677E\u867D\u7136\u665A\u5E74\u6DF1\u53D7\u75DB\u98CE\u6298\u78E8\uFF0C\u751A\u81F3\u9700\u8981\u5750\u5728\u62C5\u67B6\u4E0A\u6307\u6325\uFF0C\u4F46\u4ED6\u6307\u6325\u7684\u201C\u6258\u5C14\u65AF\u6ED5\u677E\u6218\u4E89\u201D\u51E0\u4E4E\u6467\u6BC1\u4E86\u795E\u5723\u7F57\u9A6C\u5E1D\u56FD\u7684\u610F\u5FD7\uFF0C\u662F\u4E09\u5341\u5E74\u6218\u4E89\u540E\u671F\u745E\u5178\u6700\u4EE4\u4EBA\u754F\u60E7\u7684\u7EDF\u5E05\u3002"
