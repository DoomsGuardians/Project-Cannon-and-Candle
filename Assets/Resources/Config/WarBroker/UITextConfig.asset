  TooltipBtnNext: "\u4E0B\u4E00\u9996"
  TooltipBtnShuffle: "\u968F\u673A\u64AD\u653E"
  IntelPersonAlpha: "\u7EA2\u8863\u4E3B\u6559\u9ECE\u585E\u7559"
  IntelPersonBeta: "\u963F\u59C6\u65AF\u7279\u4E39\u4EA4\u6613\u6240\u63AE\u5BA2"
  IntelPersonGamma: "\u6C49\u8428\u540C\u76DF\u519B\u9700\u627F\u5305\u5546"
  AlphaVeryHigh: "\u81EA\u5E03\u8D56\u6ED5\u8D39\u5C14\u5FB7\u4F1A\u6218\u4EE5\u6765\uFF0C\u6B27\u9646\u672A\u89C1\u5982\u6B64\u6FC0\u6218\u3002\u5404\u56FD\u5BAB\u5EF7\u90FD\u5728\u75AF\u72C2\u91C7\u8D2D\u519B\u9700\uFF0C\u7EF4\u4E5F\u7EB3\u4E0E\u5DF4\u9ECE\u7684\u4F7F\u8005\u7EDC\u7ECE\u4E8E\u9014\u3002\u6B64\u4E43\u5343\u8F7D\u96BE\u9022\u4E4B\u826F\u673A\u3002"
  AlphaHigh: "\u6CE2\u5E0C\u7C73\u4E9A\u7684\u6218\u706B\u6B63\u5411\u8428\u514B\u68EE\u8513\u5EF6\uFF0C\u65B0\u6559\u8BF8\u4FAF\u60F6\u60F6\u4E0D\u5B89\u3002\u519B\u9700\u4EF7\u683C\u5FC5\u5C06\u6C34\u6DA8\u8239\u9AD8\uFF0C\u660E\u667A\u4E4B\u4EBA\u5F53\u65E9\u505A\u51C6\u5907\u3002"
  AlphaMedium: "\u6218\u4E8B\u80F6\u7740\u4E8E\u65E5\u8033\u66FC\u8179\u5730\uFF0C\u53CC\u65B9\u50F5\u6301\u4E0D\u4E0B\u3002\u5E1D\u56FD\u519B\u4E0E\u745E\u5178\u4EBA\u90FD\u5728\u8214\u8210\u4F24\u53E3\uFF0C\u89C2\u671B\u4E3A\u4E0A\u3002"
  AlphaLow: "\u524D\u7EBF\u6682\u65E0\u5927\u52A8\u4F5C\uFF0C\u636E\u95FB\u53CC\u65B9\u6B63\u5728\u5A01\u65AF\u7279\u4F10\u5229\u4E9A\u79D8\u5BC6\u63A5\u89E6\u3002\u519B\u9700\u9700\u6C42\u4E00\u65F6\u96BE\u6709\u8D77\u8272\u3002"
  AlphaVeryLow: "\u548C\u8C08\u98CE\u58F0\u56DB\u8D77\uFF0C\u636E\u8BF4\u5965\u65AF\u7EB3\u5E03\u5415\u514B\u5DF2\u6709\u4F7F\u56E2\u62B5\u8FBE\u3002\u82E5\u771F\u8BAE\u548C\uFF0C\u519B\u9700\u5E02\u573A\u6050\u5C06\u9047\u51B7\uFF0C\u8BF8\u4F4D\u5F53\u65E9\u505A\u6253\u7B97\u3002"
  BetaVeryHigh: "\u81EA\u90C1\u91D1\u9999\u72C2\u70ED\u4EE5\u6765\uFF0C\u963F\u59C6\u65AF\u7279\u4E39\u672A\u89C1\u5982\u6B64\u76DB\u51B5\uFF01\u4E70\u76D8\u6C79\u6D8C\uFF0C\u8FDE\u5A01\u5C3C\u65AF\u7684\u94F6\u884C\u5BB6\u90FD\u5728\u62A2\u8D2D\u3002\u8BF8\u541B\u5207\u52FF\u9519\u5931\u826F\u673A\uFF0C\u4EF7\u683C\u6276\u6447\u76F4\u4E0A\u6307\u65E5\u53EF\u5F85\u3002"
  BetaHigh: "\u4EA4\u6613\u6D3B\u8DC3\uFF0C\u70ED\u90A3\u4E9A\u4E0E\u5B89\u7279\u536B\u666E\u7684\u5546\u4EBA\u90FD\u5728\u79EF\u6781\u5165\u5E02\u3002\u4E70\u65B9\u5360\u636E\u4E3B\u52A8\uFF0C\u884C\u60C5\u7A33\u6B65\u6500\u5347\u3002"
  BetaMedium: "\u4E70\u5356\u53CC\u65B9\u52BF\u5747\u529B\u654C\uFF0C\u4EF7\u683C\u6CE2\u52A8\u6709\u9650\u3002\u6CD5\u5170\u514B\u798F\u7684\u5546\u4F1A\u6301\u89C2\u671B\u6001\u5EA6\uFF0C\u5E02\u573A\u6682\u4E14\u5E73\u9759\u3002"
  BetaLow: "\u629B\u552E\u538B\u529B\u6E10\u589E\uFF0C\u636E\u95FB\u5965\u683C\u65AF\u5821\u7684\u5BCC\u683C\u5C14\u5BB6\u65CF\u6B63\u5728\u6E05\u4ED3\u3002\u4E70\u65B9\u6301\u5E01\u89C2\u671B\uFF0C\u884C\u60C5\u627F\u538B\u4E0B\u884C\u3002"
  BetaVeryLow: "\u6050\u614C\u5982\u761F\u75AB\u822C\u8513\u5EF6\uFF01\u5356\u76D8\u5982\u6F6E\uFF0C\u8FDE\u79D1\u9686\u7684\u4E3B\u6559\u90FD\u5728\u629B\u552E\u5B58\u8D27\u3002\u4EF7\u683C\u4E00\u6CFB\u5343\u91CC\uFF0C\u8840\u6D41\u6210\u6CB3\u3002"
  GammaVeryHigh: "\u4ECE\u5415\u8D1D\u514B\u5230\u4F46\u6CFD\uFF0C\u8D27\u6E90\u5947\u7F3A\uFF01\u6CE2\u7F57\u7684\u6D77\u822A\u7EBF\u53D7\u963B\uFF0C\u4ED3\u5E93\u51E0\u8FD1\u89C1\u5E95\u3002\u6709\u4EF7\u65E0\u5E02\uFF0C\u624B\u4E2D\u6709\u8D27\u8005\u5F85\u4EF7\u800C\u6CBD\u3002"
  GammaHigh: "\u6C49\u5821\u4E0E\u4E0D\u83B1\u6885\u7684\u5E93\u5B58\u6D88\u8017\u52A0\u5FEB\uFF0C\u8865\u7ED9\u8239\u961F\u8FDF\u8FDF\u672A\u81F3\u3002\u4F9B\u4E0D\u5E94\u6C42\u4E4B\u52BF\u6E10\u663E\uFF0C\u4EF7\u683C\u770B\u6DA8\u3002"
  GammaMedium: "\u4F9B\u9700\u5C1A\u7B97\u5E73\u8861\uFF0C\u83B1\u8335\u6CB3\u6CBF\u5CB8\u7684\u4ED3\u50A8\u5468\u8F6C\u6B63\u5E38\u3002\u65AF\u7279\u62C9\u65AF\u5821\u7684\u5546\u4F1A\u62A5\u544A\u5E93\u5B58\u7A33\u5B9A\u3002"
  GammaLow: "\u6CE2\u897F\u7C73\u4E9A\u7684\u77FF\u5C71\u590D\u4EA7\uFF0C\u8D27\u6E90\u6E10\u4E30\u3002\u7EBD\u4F26\u5821\u7684\u4ED3\u5E93\u5806\u79EF\u5982\u5C71\uFF0C\u5356\u65B9\u6025\u4E8E\u51FA\u8D27\u5957\u73B0\u3002"
  GammaVeryLow: "\u5E02\u573A\u5145\u65A5\u5B58\u8D27\uFF01\u897F\u91CC\u897F\u4E9A\u7684\u94C1\u77FF\u6D8C\u5165\u5E02\u573A\uFF0C\u4ED3\u50A8\u538B\u529B\u5267\u589E\u3002\u82E5\u4E0D\u5C3D\u5FEB\u51FA\u624B\uFF0C\u6050\u5C06\u8840\u672C\u65E0\u5F52\u3002"
  IntelRumorHeader: "\u3010\u6218\u573A\u4F20\u95FB\u3011"
  IntelRumorSource: "\u9014\u7ECF\u83B1\u6BD4\u9521\u7684\u5546\u961F"
  RumorDefensive: "\u636E\u4ECE\u9A6C\u683C\u5FB7\u5821\u9003\u6765\u7684\u96BE\u6C11\u79F0\uFF0C\u5E1D\u56FD\u519B\u8282\u8282\u8D25\u9000\uFF0C\u5317\u65B9\u96C4\u72EE\u7684\u94C1\u8E44\u5DF2\u903C\u8FD1\u8179\u5730\uFF0C\u5F62\u52BF\u4E07\u5206\u5371\u6025\u3002\u7EF4\u4E5F\u7EB3\u5BAB\u5EF7\u4EBA\u5FC3\u60F6\u60F6\u3002"
  RumorStalemate: "\u6709\u4ECE\u7EBD\u4F26\u5821\u6765\u7684\u4FE1\u4F7F\u900F\u9732\uFF0C\u53CC\u65B9\u4E3B\u529B\u5728\u65E5\u8033\u66FC\u8179\u5730\u5BF9\u5CD9\uFF0C\u745E\u5178\u4EBA\u5360\u636E\u6709\u5229\u5730\u5F62\uFF0C\u800C\u5E1D\u56FD\u519B\u56FA\u5B88\u57CE\u6C60\u3002\u80DC\u8D1F\u5C1A\u96BE\u9884\u6599\u3002"
  RumorOffensive: "\u9A7F\u7AD9\u4F20\u6765\u6377\u62A5\uFF0C\u636E\u79F0\u534E\u4F26\u65AF\u5766\u5143\u5E05\u6325\u5E08\u5317\u8FDB\uFF0C\u5DF2\u6DF1\u5165\u654C\u5883\u3002\u745E\u5178\u4EBA\u7684\u8865\u7ED9\u7EBF\u5C8C\u5C8C\u53EF\u5371\uFF0C\u6216\u5C06\u88AB\u8FEB\u540E\u64A4\u3002"
  RumorMixed: "\u5404\u8DEF\u6218\u62A5\u771F\u5047\u96BE\u8FA8\uFF1A\u6709\u8BF4\u745E\u5178\u4EBA\u5728\u8428\u514B\u68EE\u5927\u6377\uFF0C\u53C8\u6709\u4F20\u95FB\u5E1D\u56FD\u519B\u5728\u5DF4\u4F10\u5229\u4E9A\u53CD\u653B\u3002\u6218\u5C40\u6251\u6714\u8FF7\u79BB\uFF0C\u552F\u6709\u9759\u89C2\u5176\u53D8\u3002"
  RumorReservesHigh: "\u540E\u65B9\u8482\u7F57\u5C14\u7684\u5F81\u5175\u987A\u5229\uFF0C\u6CE2\u897F\u7C73\u4E9A\u7684\u7CAE\u8349\u4EA6\u5DF2\u7B79\u9F50\uFF0C\u8865\u7ED9\u5C1A\u7B97\u5145\u88D5\u3002"
  RumorReservesLow: "\u4F46\u4EA6\u6709\u4F20\u95FB\uFF0C\u8FDE\u5E74\u5F81\u6218\u5DF2\u4EE4\u519C\u5E84\u51CB\u655D\uFF0C\u540E\u52E4\u8865\u7ED9\u65E5\u6E10\u6349\u895F\u89C1\u8098\u3002"
  RumorReservesCritical: "\u66F4\u6709\u6D41\u8A00\u79F0\u519B\u4E2D\u5DF2\u65AD\u7CAE\u4E09\u65E5\uFF0C\u58EB\u5175\u5F00\u59CB\u52AB\u63A0\u4E61\u91CC\u3002\u82E5\u65E0\u540E\u63F4\uFF0C\u6050\u5C06\u4E0D\u6218\u81EA\u6E83\u3002"
  IntelEnemyRumorHeader: "\u3010\u654C\u60C5\u4F20\u95FB\u3011"
  EnemyRumorHealthy: "{0}\u9EBE\u4E0B\u5175\u5F3A\u9A6C\u58EE\uFF0C\u4E0D\u53EF\u5C0F\u89D1\u3002"
  EnemyRumorWounded: "\u636E\u95FB{0}\u90E8\u6709\u6240\u51CF\u5458\uFF0C\u6218\u529B\u6216\u5DF2\u524A\u5F31\u3002"
  EnemyRumorCritical: "\u6709\u4FE1\u4F7F\u79F0{0}\u90E8\u4F24\u4EA1\u60E8\u91CD\uFF0C\u6E83\u6563\u5728\u5373\u3002"
  EnemyRumorRouted: "{0}\u90E8\u5DF2\u7136\u6E83\u6563\uFF0C\u4E0D\u8DB3\u4E3A\u8651\u3002"
  IntelAllyRumorHeader: "\u3010\u6211\u519B\u52A8\u6001\u3011"
  AllyRumorHealthy: "{0}\u5C06\u519B\u6240\u90E8\u58EB\u6C14\u9AD8\u6602\uFF0C\u6795\u6208\u5F85\u65E6\u3002"
  AllyRumorWounded: "\u636E\u540E\u65B9\u8F8E\u91CD\u8425\u56DE\u62A5\uFF0C{0}\u90E8\u8FD1\u65E5\u4F24\u4EA1\u9887\u91CD\uFF0C\u6B63\u5728\u6574\u8865\u3002"
  AllyRumorCritical: "\u6709\u4F24\u5175\u9003\u56DE\u79F0{0}\u90E8\u5DF2\u662F\u6B8B\u5175\u8D25\u5C06\uFF0C\u4E9F\u9700\u589E\u63F4\u3002"
  AllyRumorRouted: "{0}\u90E8\u5DF2\u6E83\u4E0D\u6210\u519B\uFF0C\u65D7\u5E1C\u5C3D\u5931\uFF0C\u5C06\u519B\u4E0B\u843D\u4E0D\u660E\u3002"
  IntelBattleHistoryHeader: "\u3010\u6218\u53F2\u8BC4\u8BF4\u3011"
  BattleHistoryNone: "\u6218\u7AEF\u65B9\u542F\uFF0C\u5C1A\u65E0\u53EF\u8D44\u8BC4\u8BF4\u4E4B\u5F79\u3002"
  BattleHistoryAllyVictory: "\u8FDE\u6218\u8FDE\u6377\uFF01\u8FD1\u6765\u6211\u519B\u52BF\u5982\u7834\u7AF9\uFF0C{0}\u6218\u7686\u514B\uFF0C\u58EB\u6C14\u5927\u632F\u3002\u574A\u95F4\u5DF2\u6709\u4EBA\u5C06\u6B64\u6BD4\u4F5C\u53E4\u65AF\u5854\u592B\u7684\u8F89\u714C\u6218\u7EE9\u3002"
  BattleHistoryEnemyVictory: "\u5F62\u52BF\u582A\u5FE7\uFF01\u8FD1\u6765{0}\u5F79\u7686\u5931\uFF0C\u519B\u5FC3\u52A8\u6447\uFF0C\u540E\u65B9\u5DF2\u6709\u6D41\u8A00\u871A\u8BED\u3002\u6709\u4EBA\u79C1\u4E0B\u8BAE\u8BBA\uFF0C\u8BF4\u8FD9\u662F\u534E\u4F26\u65AF\u5766\u590D\u4EC7\u7684\u5F00\u59CB\u3002"
  BattleHistoryStalemate: "\u8FD1\u6765\u6218\u4E8B\u80F6\u7740\uFF0C\u53CC\u65B9\u5404\u6709\u65A9\u83B7\uFF0C\u96BE\u5206\u8F69\u8F7E\u3002\u6709\u8001\u5175\u8BF4\u8FD9\u8BA9\u4ED6\u60F3\u8D77\u4E86\u5F53\u5E74\u7684\u767D\u5C71\u4E4B\u6218\u524D\u5915\u3002"
  BattleHistoryMixed: "\u6218\u5C40\u53D8\u5E7B\u83AB\u6D4B\uFF0C\u80DC\u8D25\u4EA4\u66FF\u3002\u6709\u4EBA\u8BF4\u8FD9\u662F\u795E\u610F\u96BE\u6D4B\uFF0C\u4E5F\u6709\u4EBA\u8BF4\u8FD9\u6B63\u662F\u7528\u5175\u8005\u7684\u826F\u673A\u3002"
  BattleHistoryCritLegend: "\u8336\u9986\u91CC\u90FD\u5728\u4F20\u9882{0}\u5C06\u519B\u7684\u795E\u52C7\u2014\u2014\u636E\u8BF4\u90A3\u4E00\u6218\uFF0C\u4ED6\u4EB2\u7387\u9A91\u5175\u51B2\u950B\uFF0C\u6740\u5F97\u654C\u519B\u4E22\u76D4\u5F03\u7532\u3002"
  BattleHistoryFumbleLegend: "\u6709\u4EBA\u6084\u6084\u8BAE\u8BBA{0}\u5C06\u519B\u4E0A\u6B21\u6307\u6325\u5931\u5F53\u2014\u2014\u636E\u8BF4\u662F\u8F8E\u91CD\u8FF7\u8DEF\uFF0C\u8D3B\u8BEF\u4E86\u6218\u673A\u3002"
