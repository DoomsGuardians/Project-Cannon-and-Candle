  TooltipBtnClose: "\u63D0\u524D\u5E73\u4ED3\uFF0C\u6309\u5F53\u524D\u4EF7\u683C\u7ED3\u7B97\u76C8\u4E8F"
  TooltipBtnReinforce: "\u6D88\u8017\u5BF9\u5E94\u6307\u4EE4\uFF0C\u5F3A\u5316\u8BE5\u5C06\u519B\u7684\u610F\u56FE\uFF08\u6D88\u8017\u6570\u91CF\u89C1\u914D\u7F6E\uFF09"
  TooltipBtnOverride: "\u6D88\u8017\u6307\u4EE4\uFF0C\u5F3A\u5236\u6539\u53D8\u5C06\u519B\u7684\u884C\u52A8\u610F\u56FE\uFF08\u6D88\u8017\u6570\u91CF\u89C1\u914D\u7F6E\uFF09"
  TooltipBtnPrevious: "\u4E0A\u4E00\u9996"
