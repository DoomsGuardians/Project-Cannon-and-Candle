  FuturesCloseHints:
  - "\u662F\u65F6\u5019\u7ED3\u6E05\u4E00\u4E9B\u671F\u8D27\u4ED3\u4F4D\u4E86\u3002"
  - "\u8FD9\u4E9B\u671F\u8D27\u5408\u7EA6\u5230\u4E86\u8BE5\u4E86\u7ED3\u7684\u65F6\u5019\u3002"
