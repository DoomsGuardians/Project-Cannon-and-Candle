  StrategyOpenings:
  - Strategy: 0
    Dialogues:
    - "\u6218\u573A\u5C40\u52BF\u7D27\u5F20\uFF0C\u6211\u5FC5\u987B\u5168\u529B\u652F\u63F4\u6211\u7684\u5C06\u519B\u4EEC\u3002"
    - "\u519B\u4E8B\u4F18\u5148\u3002\u91D1\u878D\u53EF\u4EE5\u7B49\uFF0C\u4F46\u6218\u7EBF\u4E0D\u80FD\u4E22\u3002"
    - "\u6211\u7684\u5C06\u519B\u4EEC\u9700\u8981\u8865\u7ED9\uFF0C\u8FD9\u662F\u5F53\u52A1\u4E4B\u6025\u3002"
  - Strategy: 1
    Dialogues:
    - "\u5E02\u573A\u8D8B\u52BF\u660E\u663E\uFF0C\u662F\u65F6\u5019\u987A\u52BF\u800C\u4E3A\u4E86\u3002"
    - "\u4EF7\u683C\u8D70\u52BF\u6E05\u6670\uFF0C\u806A\u660E\u4EBA\u90FD\u77E5\u9053\u8BE5\u600E\u4E48\u505A\u3002"
    - "\u8D8B\u52BF\u662F\u4F60\u7684\u670B\u53CB\uFF0C\u76F4\u5230\u5B83\u53CD\u8F6C\u3002"
  - Strategy: 2
    Dialogues:
    - "\u6211\u6CE8\u610F\u5230\u67D0\u4E9B\u4EBA\u7684\u4ED3\u4F4D\u6709\u4E9B...\u66B4\u9732\u4E86\u3002"
    - "\u4F60\u7684\u4EA4\u6613\u75D5\u8FF9\u6BD4\u4F60\u60F3\u8C61\u7684\u66F4\u660E\u663E\u3002"
    - "\u6709\u4EBA\u5728\u5E02\u573A\u4E0A\u592A\u8FC7\u6D3B\u8DC3\u4E86\uFF0C\u4E0D\u662F\u5417\uFF1F"
  - Strategy: 3
    Dialogues:
    - "\u5E02\u573A\u9700\u8981\u4E00\u4E9B...\u523A\u6FC0\u3002"
    - "\u8BA9\u6211\u6765\u5236\u9020\u4E00\u4E9B\u6709\u8DA3\u7684\u4FE1\u53F7\u3002"
    - "\u6709\u65F6\u5019\uFF0C\u6700\u597D\u7684\u7B56\u7565\u662F\u8BA9\u5BF9\u624B\u731C\u4E0D\u900F\u3002"
  - Strategy: 4
    Dialogues:
    - "\u662F\u65F6\u5019\u6536\u83B7\u4E86\u3002"
    - "\u5229\u6DA6\u4E0D\u5B9E\u73B0\u5C31\u4E0D\u662F\u5229\u6DA6\u3002"
    - "\u843D\u888B\u4E3A\u5B89\uFF0C\u8FD9\u662F\u94C1\u5F8B\u3002"
  SpotBuyHints:
  - "\u6211\u5BF9{0}\u6307\u4EE4\u5F88\u6709\u4FE1\u5FC3\u3002"
  - "{0}\u6307\u4EE4\u770B\u8D77\u6765\u5F88\u6709\u4EF7\u503C\u3002"
