  CampaignId: Campaign_Tutorial
  CampaignName: "\u5FB7\u7ECD\u6218\u5F79"
  Description: "\u5FB7\u7ECD\u6218\u5F79\uFF081626\u5E744\u670825\u65E5\uFF09\u662F\u4E09\u5341\u5E74\u6218\u4E89\u4E2D\u7684\u4E00\u6B21\u5173\u952E\u6218\u6597\u3002\u7531\u963F\u5C14\u5E03\u96F7\u8D6B\u7279\xB7\u51AF\xB7\u534E\u4F26\u65AF\u5766\u6307\u6325\u7684\u795E\u5723\u7F57\u9A6C\u5E1D\u56FD\u519B\u961F\uFF0C\u5728\u5FB7\u7ECD\u6865\u7684\u9632\u5FA1\u5DE5\u4E8B\u540E\uFF0C\u6210\u529F\u51FB\u9000\u4E86\u6069\u65AF\u7279\xB7\u51AF\xB7\u66FC\u65AF\u83F2\u5C14\u5FB7\u4F2F\u7235\u7387\u9886\u7684\u65B0\u6559\u519B\u961F\u7684\u8FDB\u653B\u3002\u6B64\u5F79\u91CD\u521B\u65B0\u6559\u8054\u519B\uFF0C\u4E3A\u4E39\u9EA6\u56FD\u738B\u514B\u91CC\u65AF\u8482\u5B89\u56DB\u4E16\u6700\u7EC8\u9000\u51FA\u6218\u4E89\u57CB\u4E0B\u4F0F\u7B14\u3002\n\u521D\u59CB\u6218\u5F79\uFF0C\u5B66\u4E60\u5E02\u573A\u4EA4\u6613\u3001\u6307\u4EE4\u5206\u914D\u4E0E\u6218\u573A\u7BA1\u7406\u7684\u57FA\u672C\u64CD\u4F5C\u3002"
