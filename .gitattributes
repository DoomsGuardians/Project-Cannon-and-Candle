# ============================================ #
# Unity Smart Merge                            #
# ============================================ #
*.unity merge=unityyamlmerge eol=lf
*.prefab merge=unityyamlmerge eol=lf
*.asset merge=unityyamlmerge eol=lf
*.meta merge=unityyamlmerge eol=lf
*.controller merge=unityyamlmerge eol=lf
*.anim merge=unityyamlmerge eol=lf

# ============================================ #
# Text files - normalize to LF                 #
# ============================================ #
*.cs text diff=csharp eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.compute text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# ============================================ #
# Binary files (mark as binary, no merge)      #
# ============================================ #
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.tga binary
*.tif binary
*.tiff binary
*.psd binary
*.exr binary
*.hdr binary

# 3D Models
*.fbx binary
*.obj binary
*.blend binary
*.3ds binary
*.dae binary
*.max binary
*.mb binary
*.ma binary

# Audio
*.mp3 binary
*.wav binary
*.ogg binary
*.aif binary
*.aiff binary

# Video
*.mp4 binary
*.mov binary
*.avi binary
*.webm binary

# Fonts
*.ttf binary
*.otf binary

# Archives
*.zip binary
*.7z binary
*.rar binary
*.gz binary

# Unity specific binary
*.dll binary
*.so binary
*.dylib binary
*.cubemap binary
*.unitypackage binary

